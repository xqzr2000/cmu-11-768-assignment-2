# Optional local provider configuration for future, online phases.
# Prefer Codespaces Secrets for ZAI_API_KEY; NEVER commit a real token.
# ZAI_API_KEY=   (set as Codespaces secret, do not fill in here)
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash

# Vision validator endpoint is deliberately left unset in Phase 0.
# The course-provided Modal settings remain in .env.example as upstream reference.
