# --- Independent adaptation: GPT-6.1 Terra as the judge -------------------
# Use these instead of the Modal VALIDATOR_* lines below. With api.openai.com
# the client falls back to the OPENAI_API_KEY Codespaces secret, so no key is
# needed in this file. Flex tier halves the price; it is slower and may 429.
# VALIDATOR_BASE_URL=https://api.openai.com/v1
# VALIDATOR_MODEL=gpt-6.1-terra
# VALIDATOR_REASONING_EFFORT=none
# VALIDATOR_SERVICE_TIER=flex
# VALIDATOR_USAGE_LOG=output/judge_usage.jsonl

# Your validator deploy command prints this URL. Replace <workspace> with your
# Modal workspace slug and keep the /v1 suffix.
VALIDATOR_BASE_URL=https://<workspace>--hw2-validator-model-validatorserver-serve.modal.run/v1

# Your own Modal proxy token in combined form: <token-id>.<token-secret>.
# This is needed to call the endpoint, but not to deploy it.
VALIDATOR_API_KEY=wk-xxxxxxxx.ws-xxxxxxxx

# Stable alias exposed by infrastructure/validator_model.py.
VALIDATOR_MODEL=validator

# The generation deploy prints one URL for each class. Append /v1 to each URL.
GENERATION_QWEN_BASE_URL=https://<workspace>--hw2-generation-models-qwenserver-serve.modal.run/v1
GENERATION_MINISTRAL_BASE_URL=https://<workspace>--hw2-generation-models-ministralserver-serve.modal.run/v1
GENERATION_GLM_BASE_URL=https://<workspace>--hw2-generation-models-glmserver-serve.modal.run/v1

# The same workspace proxy token authenticates all three generation endpoints.
GENERATION_API_KEY=wk-xxxxxxxx.ws-xxxxxxxx

# Optional independent OpenAI vision pilot (scripts/openai_seed_pilot.py).
# Preferred: set OPENAI_API_KEY as a GitHub Codespaces secret, scoped to this repo,
# then stop and restart the Codespace. Do not commit a real token.
# Alternatively, add OPENAI_API_KEY=... to your local, ignored .env file.
# This pilot is separate from VALIDATOR_MODEL and from ZAI_API_KEY.
# OPENAI_API_KEY=your-secret-key

# Session 008 experimental multi-provider adapters (NOT the official Modal/Qwen setup).
# Set secrets with GitHub Codespaces Secrets or locally in ignored .env.
# The endpoints and exact API model IDs are fixed in integrations/models.py.
# The default provider_preflight.py performs ZERO API requests.
# A future explicitly approved smoke test may need these:
# DEEPSEEK_API_KEY=your-deepseek-secret
# OPENAI_API_KEY=your-openai-secret
# ZAI_API_KEY=your-zai-secret
